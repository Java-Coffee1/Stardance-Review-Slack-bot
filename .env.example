# Slack app credentials — from api.slack.com/apps > your app
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# The channel to watch (channel ID, e.g. C0123ABC456 — right-click channel > View details > copy ID)
SLACK_CHANNEL_ID=

# The review bot's bot_id (not its user id) — locks down which messages are
# trusted as real submission/review/approval events, instead of trusting any
# message that merely *looks* like one. Find it by running `node src/inspect.js`
# and reading the "bot_id" field on a real review-bot message. Leave blank to
# disable this check (not recommended in production).
REVIEW_BOT_ID=

# Web server port for the dashboard + API
PORT=3000